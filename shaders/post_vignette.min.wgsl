alias C=vec4f;struct VertexInput{@location(0)position:vec3f,@location(1)uv:vec2f}struct VertexOutput{@builtin(position)clip_position:C,@location(0)uv:vec2f}@group(1)@binding(0)var B:texture_2d<f32>;@group(1)@binding(1)var b:sampler;@vertex fn vs_main(A:VertexInput)->VertexOutput{return VertexOutput(C(A.position,1),A.uv);}@fragment fn fs_main(a:VertexOutput)->@location(0)C{let A=textureSample(B,b,a.uv);return C(A.xyz*(1-smoothstep(.3,.75,distance(a.uv,vec2(.5)))*.7),A.w);}